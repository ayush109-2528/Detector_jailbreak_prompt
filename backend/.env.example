# Configure this server-only secret in Vercel. Do not put real credentials here.
# Copy the actual Transaction pooler URI from Supabase Connect.
# DATABASE_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Local uvicorn does not automatically load this file; export environment variables
# or pass --env-file with a private .env file.
# Optional project API settings; these do NOT replace DATABASE_URL or permit SQL migrations.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_public_anon_key
# This backend uses PostgreSQL directly; neither API setting is needed for private storage.
# PC worker only (do not enable AUTO_LEARNING in Vercel):
# AUTO_LEARNING=1
# ADMIN_API_KEY=your_private_researcher_key
# LEARNING_INTERVAL_SECONDS=3600
# AUTO_DEPLOY_VERCEL=0
# DATASET_FILE=C:/absolute/path/to/HMEG_300K_Augmented_Dataset.csv
# Set the same server-only ADMIN_API_KEY on Vercel before enabling reviewed-label learning.
